<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
<define/><materials/>
<solids><box name="WorldS" x="100" y="100" z="100" lunit="mm"/><box name="ScintS" x="2.5" y="2.5" z="2.0" lunit="mm"/><box name="ObjectS" x="1" y="1" z="0.001" lunit="mm"/></solids>
<structure>
<volume name="Scint"><materialref ref="G4_GADOLINIUM_OXYSULFIDE"/><solidref ref="ScintS"/></volume>
<volume name="Object"><materialref ref="G4_Galactic"/><solidref ref="ObjectS"/></volume>
<volume name="World"><materialref ref="G4_Galactic"/><solidref ref="WorldS"/>
 <physvol name="Scint"><volumeref ref="Scint"/><position name="sp" x="0" y="0" z="0" unit="mm"/></physvol>
</volume>
</structure>
<setup name="Default" version="1.0"><world ref="World"/></setup>
</gdml>